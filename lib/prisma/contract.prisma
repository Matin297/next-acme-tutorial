// use prisma-next

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  imageUrl  String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt temporal.updatedAt()
}

model Invoice {
  id         String        @id @default(uuid())
  customerId String
  amount     Int
  date       DateTime
  status     InvoiceStatus
  customer   Customer      @relation(fields: [customerId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  temporal.updatedAt()
}

model Revenue {
  month     String   @id
  revenue   Int
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

enum InvoiceStatus {
  pending
  paid
}